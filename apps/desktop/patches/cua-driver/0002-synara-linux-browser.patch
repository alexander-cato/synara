+//! Lifetime and epoch admission for a driver-owned browser operation.
+//!
+//! This gate owns no desktop input or platform target state. The shared CDP
+//! cancellation scope checks its captured epoch before dispatch and reports
+//! unacknowledged matching releases. The admitted operation retains its lease
+//! until those releases finish, so an interruption never acknowledges a drain
+//! merely because a transport stopped awaiting the result.
+
+use std::sync::{Condvar, Mutex, MutexGuard, OnceLock};
+use std::time::{Duration, Instant};
+
+// The authenticated desktop host represents epochs as JavaScript integers.
+const MAX_INPUT_EPOCH: u64 = 9_007_199_254_740_991;
+
+#[derive(Default)]
+struct State {
+    epoch: u64,
+    interrupted: bool,
+    retired: bool,
+    operations: usize,
+    uncertain_releases: usize,
+}
+
+#[derive(Default)]
+pub struct OperationGate {
+    state: Mutex<State>,
+    changed: Condvar,
+}
+
+pub struct Interruption {
+    pub epoch: u64,
+    pub pending: usize,
+    pub resumed: bool,
+}
+
+pub fn gate() -> &'static OperationGate {
+    static GATE: OnceLock<OperationGate> = OnceLock::new();
+    GATE.get_or_init(OperationGate::default)
+}
+
+impl OperationGate {
+    fn lock(&self) -> MutexGuard<'_, State> {
+        self.state.lock().unwrap_or_else(|error| error.into_inner())
+    }
+
+    fn validate(state: &State, epoch: u64) -> anyhow::Result<()> {
+        if state.retired || state.interrupted || state.epoch != epoch {
+            anyhow::bail!("browser_input_cancelled: action admission was interrupted");
+        }
+        Ok(())
+    }
+
+    /// Admission is synchronous and must happen before asynchronous preflight.
+    /// A trusted host supplies the epoch it captured before writing the socket;
+    /// standalone calls capture here. Buffered old requests cannot be renewed.
+    pub fn admit(&self, expected_epoch: Option<u64>) -> anyhow::Result<OperationLease<'_>> {
+        let mut state = self.lock();
+        let epoch = expected_epoch.unwrap_or(state.epoch);
+        Self::validate(&state, epoch)?;
+        state.operations = state
+            .operations
+            .checked_add(1)
+            .ok_or_else(|| anyhow::anyhow!("browser operation accounting exhausted"))?;
+        Ok(OperationLease { gate: self, epoch })
+    }
+
+    pub fn checkpoint(&self, epoch: u64) -> anyhow::Result<()> {
+        Self::validate(&self.lock(), epoch)
+    }
+
+    pub fn has_unconfirmed_releases(&self) -> bool {
+        self.lock().uncertain_releases != 0
+    }
+
+    pub fn mark_unconfirmed_release(&self) {
+        let mut state = self.lock();
+        state.uncertain_releases = state.uncertain_releases.saturating_add(1);
+        state.interrupted = true;
+        self.changed.notify_all();
+    }
+
+    pub fn interrupt_and_wait(&self, timeout: Duration) -> Interruption {
+        let deadline = Instant::now() + timeout;
+        let mut state = self.lock();
+        state.interrupted = true;
+        match state
+            .epoch
+            .checked_add(1)
+            .filter(|epoch| *epoch <= MAX_INPUT_EPOCH)
+        {
+            Some(epoch) => state.epoch = epoch,
+            None => state.retired = true,
+        }
+        let epoch = state.epoch;
+        self.changed.notify_all();
+        state = self.wait_for_drain(state, deadline);
+        let pending = state.operations.saturating_add(state.uncertain_releases);
+        let resumed = pending == 0 && !state.retired && state.epoch == epoch;
+        if resumed {
+            state.interrupted = false;
+        }
+        Interruption {
+            epoch,
+            pending,
+            resumed,
+        }
+    }
+
+    pub fn cancel_and_wait(&self, timeout: Duration) -> usize {
+        let deadline = Instant::now() + timeout;
+        let mut state = self.lock();
+        state.retired = true;
+        self.changed.notify_all();
+        let state = self.wait_for_drain(state, deadline);
+        state.operations.saturating_add(state.uncertain_releases)
+    }
+
+    fn wait_for_drain<'a>(
+        &self,
+        mut state: MutexGuard<'a, State>,
+        deadline: Instant,
+    ) -> MutexGuard<'a, State> {
+        while state.operations != 0 {
+            let Some(remaining) = deadline.checked_duration_since(Instant::now()) else {
+                break;
+            };
+            let (next, timeout) = self
+                .changed
+                .wait_timeout(state, remaining)
+                .unwrap_or_else(|error| error.into_inner());
+            state = next;
+            if timeout.timed_out() {
+                break;
+            }
+        }
+        state
+    }
+}
+
+pub struct OperationLease<'a> {
+    gate: &'a OperationGate,
+    epoch: u64,
+}
+
+impl OperationLease<'_> {
+    pub fn epoch(&self) -> u64 {
+        self.epoch
+    }
+}
+
+impl Drop for OperationLease<'_> {
+    fn drop(&mut self) {
+        let mut state = self.gate.lock();
+        state.operations -= 1;
+        self.gate.changed.notify_all();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::Arc;
+
+    #[test]
+    fn buffered_pre_interrupt_epoch_is_rejected_after_acknowledged_reopen() {
+        let gate = OperationGate::default();
+        let interrupted = gate.interrupt_and_wait(Duration::ZERO);
+        assert_eq!(interrupted.epoch, 1);
+        assert_eq!(interrupted.pending, 0);
+        assert!(interrupted.resumed);
+        assert!(gate.admit(Some(0)).is_err());
+        assert!(gate.admit(Some(1)).is_ok());
+    }
+
+    #[test]
+    fn a_timed_out_operation_keeps_admission_closed_until_a_later_drain() {
+        let gate = OperationGate::default();
+        let operation = gate.admit(Some(0)).unwrap();
+        let interrupted = gate.interrupt_and_wait(Duration::ZERO);
+        assert_eq!(interrupted.pending, 1);
+        assert!(!interrupted.resumed);
+        assert!(gate.admit(Some(1)).is_err());
+        assert!(gate.checkpoint(operation.epoch()).is_err());
+        drop(operation);
+        let drained = gate.interrupt_and_wait(Duration::ZERO);
+        assert_eq!(drained.pending, 0);
+        assert!(drained.resumed);
+        assert!(gate.admit(Some(drained.epoch)).is_ok());
+    }
+
+    #[test]
+    fn uncertain_release_never_becomes_a_successful_drain() {
+        let gate = OperationGate::default();
+        let operation = gate.admit(Some(0)).unwrap();
+        gate.mark_unconfirmed_release();
+        drop(operation);
+        for _ in 0..2 {
+            let interrupted = gate.interrupt_and_wait(Duration::ZERO);
+            assert_eq!(interrupted.pending, 1);
+            assert!(!interrupted.resumed);
+        }
+        assert!(gate.has_unconfirmed_releases());
+        assert_eq!(gate.cancel_and_wait(Duration::ZERO), 1);
+    }
+
+    #[test]
+    fn retirement_cannot_reopen() {
+        let gate = OperationGate::default();
+        assert_eq!(gate.cancel_and_wait(Duration::ZERO), 0);
+        assert!(!gate.interrupt_and_wait(Duration::ZERO).resumed);
+        assert!(gate.admit(None).is_err());
+    }
+
+    #[test]
+    fn epoch_exhaustion_retires_instead_of_reusing_a_buffered_epoch() {
+        let gate = OperationGate::default();
+        gate.lock().epoch = MAX_INPUT_EPOCH;
+        let interrupted = gate.interrupt_and_wait(Duration::ZERO);
+        assert_eq!(interrupted.epoch, MAX_INPUT_EPOCH);
+        assert!(!interrupted.resumed);
+        assert!(gate.admit(Some(MAX_INPUT_EPOCH)).is_err());
+    }
+
+    #[tokio::test]
+    async fn interrupt_ack_waits_for_matching_cdp_release_and_next_operation_recovers() {
+        use crate::browser::cancellation::{scope, with_release};
+        use crate::browser::cdp_ws::CdpConnection;
+        use crate::browser::mock_cdp::{MockCdpServer, MockReply};
+        use serde_json::json;
+
+        let events = Arc::new(Mutex::new(Vec::new()));
+        let server_events = events.clone();
+        let server = MockCdpServer::start(Arc::new(move |call| {
+            server_events
+                .lock()
+                .unwrap()
+                .push((call.method.clone(), call.params.clone()));
+            MockReply::ok(json!({}))
+        }))
+        .await;
+        let connection = Arc::new(CdpConnection::connect(&server.ws_url()).await.unwrap());
+        let gate = Arc::new(OperationGate::default());
+        let action_gate = gate.clone();
+        let action_connection = connection.clone();
+        let (down, received_down) = tokio::sync::oneshot::channel();
+        let (resume, resumed) = tokio::sync::oneshot::channel();
+        let action = tokio::spawn(async move {
+            let operation = action_gate.admit(Some(0)).unwrap();
+            let epoch = operation.epoch();
+            let check_gate = action_gate.clone();
+            let uncertain_gate = action_gate.clone();
+            let result = scope(
+                Arc::new(move || check_gate.checkpoint(epoch)),
+                Arc::new(move || uncertain_gate.mark_unconfirmed_release()),
+                with_release(
+                    &action_connection,
+                    "tab",
+                    "Input.dispatchKeyEvent",
+                    json!({"type":"keyDown","key":"a"}),
+                    || json!({"type":"keyUp","key":"a"}),
+                    async {
+                        down.send(()).unwrap();
+                        resumed.await.unwrap();
+                        action_connection
+                            .call(Some("tab"), "Input.insertText", json!({"text":"old"}))
+                            .await?;
+                        Ok(())
+                    },
+                ),
+            )
+            .await;
+            drop(operation);
+            result
+        });
+        received_down.await.unwrap();
+        let pending = gate.interrupt_and_wait(Duration::ZERO);
+        assert_eq!(pending.pending, 1);
+        assert!(!pending.resumed);
+        let drain_gate = gate.clone();
+        let drain = tokio::task::spawn_blocking(move || {
+            drain_gate.interrupt_and_wait(Duration::from_secs(3))
+        });
+        resume.send(()).unwrap();
+        assert!(action.await.unwrap().is_err());
+        let acknowledged = drain.await.unwrap();
+        assert!(acknowledged.resumed);
+        assert_eq!(acknowledged.pending, 0);
+        assert_eq!(
+            events
+                .lock()
+                .unwrap()
+                .iter()
+                .map(|(_, params)| params["type"].clone())
+                .collect::<Vec<_>>(),
+            vec![json!("keyDown"), json!("keyUp")]
+        );
+
+        // Reads never install an input scope, so Stop does not remove vision.
+        connection
+            .call(Some("tab"), "Page.getFrameTree", json!({}))
+            .await
+            .unwrap();
+        let operation = gate.admit(Some(acknowledged.epoch)).unwrap();
+        let epoch = operation.epoch();
+        let check_gate = gate.clone();
+        let uncertain_gate = gate.clone();
+        scope(
+            Arc::new(move || check_gate.checkpoint(epoch)),
+            Arc::new(move || uncertain_gate.mark_unconfirmed_release()),
+            connection.call(Some("tab"), "Input.insertText", json!({"text":"new"})),
+        )
+        .await
+        .unwrap();
+        assert_eq!(events.lock().unwrap().last().unwrap().1["text"], "new");
+    }
+
+    #[tokio::test]
+    async fn a_failed_cdp_release_poison_is_retained_after_the_operation_drops() {
+        use crate::browser::cancellation::{scope, with_release};
+        use crate::browser::cdp_ws::CdpConnection;
+        use crate::browser::mock_cdp::{MockCdpServer, MockReply};
+        use serde_json::json;
+
+        let server = MockCdpServer::start(Arc::new(|call| {
+            if call.params["type"] == "mouseReleased" {
+                MockReply::err(-1, "release reply unavailable")
+            } else {
+                MockReply::ok(json!({}))
+            }
+        }))
+        .await;
+        let connection = CdpConnection::connect(&server.ws_url()).await.unwrap();
+        let gate = Arc::new(OperationGate::default());
+        let operation = gate.admit(Some(0)).unwrap();
+        let epoch = operation.epoch();
+        let check_gate = gate.clone();
+        let uncertain_gate = gate.clone();
+        let result = scope(
+            Arc::new(move || check_gate.checkpoint(epoch)),
+            Arc::new(move || uncertain_gate.mark_unconfirmed_release()),
+            with_release(
+                &connection,
+                "tab",
+                "Input.dispatchMouseEvent",
+                json!({"type":"mousePressed","button":"left","x":1,"y":1}),
+                || json!({"type":"mouseReleased","button":"left","x":1,"y":1}),
+                async { Ok(()) },
+            ),
+        )
+        .await;
+        assert!(result.is_err());
+        drop(operation);
+        assert!(gate.has_unconfirmed_releases());
+        let interrupted = gate.interrupt_and_wait(Duration::ZERO);
+        assert_eq!(interrupted.pending, 1);
+        assert!(!interrupted.resumed);
+        assert!(gate.admit(Some(interrupted.epoch)).is_err());
+        assert_eq!(gate.cancel_and_wait(Duration::ZERO), 1);
+    }
+}
